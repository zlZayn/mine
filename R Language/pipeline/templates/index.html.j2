{# ===========================================================================
   R Language 专栏首页 —— index.html

   契约：页面上只出现两种可点内容
     1) 英文原文  → 本仓库 R Language/en/<slug>/index.md
     2) 中文原文  → 知乎专栏（不在本仓库）
   中文 Markdown 绝不进入本页，也绝不进入 Pages 产物。

   所有站点事实来自 site.toml，本模板里没有硬编码。
   =========================================================================== #}
<!DOCTYPE html>
<html lang="{{ site.lang }}">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ site.title }}</title>
<script src="https://cdn.tailwindcss.com"></script>
<style>
{{ card_css }}
</style>
</head>
<body class="bg-gray-50 p-6 pt-16 min-h-screen">
<a href="{{ site.corner_href }}" class="github-corner" aria-label="View source on GitHub"><svg width="80" height="80" viewBox="0 0 250 250" style="fill:#151513; color:#fff; position: absolute; top: 0; border: 0; right: 0;" aria-hidden="true"><path d="M0,0 L115,115 L130,115 L142,142 L250,250 L250,0 Z"/><path d="M128.3,109.0 C113.8,99.7 119.0,89.6 119.0,89.6 C122.0,82.7 120.5,78.6 120.5,78.6 C119.2,72.0 123.4,76.3 123.4,76.3 C127.3,80.9 125.5,87.3 125.5,87.3 C122.9,97.6 130.6,101.9 134.4,103.2" fill="currentColor" style="transform-origin: 130px 106px;" class="octo-arm"/><path d="M115.0,115.0 C114.9,115.1 118.7,116.5 119.8,115.4 L133.7,101.6 C136.9,99.2 139.9,98.4 142.2,98.6 C133.8,88.0 127.5,74.4 143.8,58.0 C148.5,53.4 154.0,51.2 159.7,51.0 C160.3,49.4 163.2,43.6 171.4,40.1 C171.4,40.1 176.1,42.5 178.8,56.2 C183.1,58.6 187.2,61.8 190.9,65.4 C194.5,69.0 197.7,73.2 200.1,77.6 C213.8,80.2 216.3,84.9 216.3,84.9 C212.7,93.1 206.9,96.0 205.4,96.6 C205.1,102.4 203.0,107.8 198.3,112.5 C181.9,128.9 168.3,122.5 157.7,114.1 C157.9,116.9 156.7,120.9 152.7,124.9 L141.0,136.5 C139.8,137.7 141.6,141.9 141.8,141.8 Z" fill="currentColor" class="octo-body"/></svg></a>
<div class="max-w-7xl mx-auto">
<div class="text-center mb-10">
<h1 class="text-4xl font-bold text-gray-800 mb-2 text-center"><a href="{{ site.logo_href }}" target="_blank" rel="noreferrer" class="inline-block"><img src="{{ site.logo_image }}" alt="{{ site.logo_alt }}" width="40" height="40" style="display: block; margin: 0 auto;"/></a></h1>
<div class="flex justify-center items-center space-x-4">
{%- for link in site.header_links %}
<a href="{{ link.href }}" target="_blank" class="link-button {{ link.style }}-link"><strong>{{ link.label }}</strong></a>
{%- endfor %}
</div>
</div>
<div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-2 lg:grid-cols-2 gap-6">
{%- for article in articles %}
<div class="article-card">
<div class="article-card-gradient bg-gradient-to-r {{ article.color_classes }}"></div>
<div class="article-card-content">
<h3 class="article-card-title">{% if article.en_title %}<span class="title-en">{{ article.en_title }}</span>{% else %}<span class="title-en title-pending">{{ pending_label }}</span>{% endif %}{% if article.zh_title %}<span class="title-zh">{{ article.zh_title }}</span>{% endif %}</h3>
<div class="article-card-links flex justify-end">
{%- if article.en_url %}
<a href="{{ article.en_url }}" target="_blank" class="link-button github-link">{{ site.english_label }}</a>
{%- else %}
<span class="link-button github-link is-missing" title="英文原文缺失">{{ site.english_label }}</span>
{%- endif %}
{%- if article.zh_url %}
<a href="{{ article.zh_url }}" target="_blank" class="link-button zhihu-link">{{ site.chinese_label }}</a>
{%- else %}
<span class="link-button zhihu-link is-missing" title="知乎链接缺失">{{ site.chinese_label }}</span>
{%- endif %}
</div>
</div>
</div>
{%- endfor %}
</div>
</div>
</body>
</html>
